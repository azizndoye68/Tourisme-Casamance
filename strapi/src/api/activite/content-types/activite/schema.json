{
  "kind": "collectionType",
  "collectionName": "activites",
  "info": {
    "singularName": "activite",
    "pluralName": "activites",
    "displayName": "Activité",
    "description": "Expériences et activités touristiques"
  },
  "options": {
    "draftAndPublish": true,
    "increments": true,
    "timestamps": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titre": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 2,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "resume": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "theme": {
      "type": "enumeration",
      "enum": ["Nature", "Culture", "Gastronomie", "Aventure", "Detente"],
      "required": true,
      "default": "Nature"
    },
    "duree": {
      "type": "string",
      "required": false,
      "description": "Ex: 2h, demi-journée, journée complète"
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "destinations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::destination.destination",
      "inversedBy": "activites"
    }
  }
}