    "react-dom": "18.3.1",
    "next-intl": "3.17.2",
    "tailwindcss": "3.4.7",
    "postcss": "8.4.41",
    "autoprefixer": "10.4.19",
    "clsx": "2.1.1",
    "tailwind-merge": "2.4.0",
    "lucide-react": "0.424.0",
    "leaflet": "1.9.4",
    "react-leaflet": "4.2.1",
    "date-fns": "3.6.0",
    "zod": "3.23.8",
    "react-hook-form": "7.52.2",
    "@hookform/resolvers": "3.9.0"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
