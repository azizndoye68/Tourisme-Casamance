{
  "name": "strapi",
  "version": "1.0.0",
  "private": true,
  "description": "Strapi v5 CMS for Tourisme Casamance",
  "scripts": {
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "strapi seed:run",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky install"
  },
  "dependencies": {
    "@strapi/strapi": "5.3.0",
    "@strapi/plugin-users-permissions": "5.3.0",
    "@strapi/plugin-i18n": "5.3.0",
    "@strapi/plugin-cloud": "5.3.0",
    "@strapi/provider-upload-cloudinary": "5.3.0",
    "better-sqlite3": "11.1.2",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.0",
    "styled-components": "6.1.12"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/pg": "8.11.6",
    "typescript": "5.5.4",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "vitest": "2.0.5",
    "husky": "9.1.6",
    "lint-staged": "15.2.7"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x",
    "npm": ">=10.0.0"
  },
  "strapi": {
    "uuid": "tourisme-casamance-strapi"
  }
}