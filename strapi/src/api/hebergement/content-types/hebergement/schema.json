{
  "kind": "collectionType",
  "collectionName": "hebergements",
  "info": {
    "singularName": "hebergement",
    "pluralName": "hebergements",
    "displayName": "Hébergement",
    "description": "Lieux où dormir"
  },
  "options": {
    "draftAndPublish": true,
    "increments": true,
    "timestamps": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 2,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["campement", "ecolodge", "hotel"],
      "required": true,
      "default": "campement"
    },
    "prixIndicatif": {
      "type": "string",
      "required": false,
      "description": "Ex: 35 000 CFA/nuit"
    },
    "contactWhatsApp": {
      "type": "string",
      "required": false,
      "description": "Numéro WhatsApp au format international (ex: +221770000000)"
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "destination": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destination.destination",
      "inversedBy": "hebergements"
    }
  }
}