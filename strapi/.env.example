# Strapi Environment Variables
# Copy to .env for local development

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=tourisme_casamance
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeme_secure_password
DATABASE_SSL=false

# Security Keys (generate with: openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=api_token_salt_change_me
ADMIN_JWT_SECRET=admin_jwt_secret_change_me
TRANSFER_TOKEN_SALT=transfer_token_salt_change_me
JWT_SECRET=jwt_secret_change_me

# Frontend URL (for CORS, webhooks, etc.)
FRONTEND_URL=http://localhost:3000

# Upload Provider (local or cloudinary)
UPLOAD_PROVIDER=local
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

# Email (optional - for contact forms, newsletters)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Tourisme Casamance <noreply@visitecasamance.com>"