{
  "name": "tourisme-casamance",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine statique de tourisme en Casamance (Sénégal)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm run build && node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "type-check": "npm --prefix frontend run type-check",
    "test": "npm --prefix frontend run test",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "install:all": "npm --prefix frontend install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "husky": "^9.1.6"
  }
}
