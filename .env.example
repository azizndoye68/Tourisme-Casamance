# ===========================================
# Tourisme-Casamance - Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs
# ===========================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=tourisme_casamance
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeme_secure_password

# --- Strapi (CMS Headless) ---
NODE_ENV=development
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=tourisme_casamance
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeme_secure_password
DATABASE_SSL=false

# Clés secrètes Strapi (générer avec `openssl rand -base64 32`)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=api_token_salt_change_me
ADMIN_JWT_SECRET=admin_jwt_secret_change_me
TRANSFER_TOKEN_SALT=transfer_token_salt_change_me
JWT_SECRET=jwt_secret_change_me

# URLs
HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token API Strapi pour le frontend (créer dans Strapi Admin > Settings > API Tokens)
STRAPI_API_TOKEN=

# --- Optionnel : Analytics (Plausible/Umami) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_API_HOST=

# --- Optionnel : Email (pour formulaire contact/newsletter) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tourisme Casamance <noreply@visitecasamance.com>"