# Frontend Environment Variables
# Copy to .env.local for local development

# Strapi CMS URL
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Site URL (for sitemap, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Strapi API Token (for preview mode, server-side fetching)
# Create in Strapi Admin > Settings > API Tokens
STRAPI_API_TOKEN=

# Optional: Analytics (Plausible/Umami)
# NEXT_PUBLIC_ANALYTICS_DOMAIN=your-domain.com
# NEXT_PUBLIC_ANALYTICS_API_HOST=https://plausible.io

# Optional: reCAPTCHA for forms
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=