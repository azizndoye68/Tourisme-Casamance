{
  "collectionName": "components_itineraires_etapes",
  "info": {
    "displayName": "Etape",
    "description": "Une étape journalière d'un itinéraire"
  },
  "options": {},
  "attributes": {
    "jour": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "titre": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "texte": {
      "type": "richtext",
      "required": true
    },
    "destination": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destination.destination"
    }
  }
}